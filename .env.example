# Spotify Developer App credentials.
# Create an app at https://developer.spotify.com/dashboard, then copy the
# Client ID, Client Secret, and a Redirect URI you've registered for the app.
#
# Production location: /etc/spotify-mcp/.env (the LXC installer copies this
# example into place). For local development, .env can also live at the repo
# root — the server logs a deprecation warning on first read.

SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# OAuth tokens (access token, refresh token, expiry) are managed automatically
# by `npm run auth` and stored in .spotify-tokens (gitignored, chmod 0600).
# You should not need to set them by hand.


# --- MCP transport ---
# 'stdio' (default): the MCP client launches this server as a subprocess and
# talks to it over stdin/stdout. Best for local Claude Desktop / Cursor use.
# 'http': run as a long-lived network service. Required for remote LXC use.
MCP_TRANSPORT=stdio

# --- HTTP transport options (only used when MCP_TRANSPORT=http) ---
# Bind address. Use 0.0.0.0 inside an LXC to accept connections from your LAN.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# Bearer token required on every request as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
# DO NOT leave this empty when binding to a non-loopback interface.
MCP_HTTP_TOKEN=
